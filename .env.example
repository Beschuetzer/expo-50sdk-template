# Copy this file to .env and update the values for your local setup.
# This project expects a local backend for Expo development.

EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_IP_ADDRESS=127.0.0.1
EXPO_PUBLIC_PORT_NUMBER=4200

# Optional values for dev-only features.
EXPO_PUBLIC_TEST_EMAIL=
EXPO_PUBLIC_TEST_PASSWORD=
EXPO_PUBLIC_GEOCODING_API_KEY=
