{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Expo web",
      "type": "shell",
      "command": "npm run web",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "expo",
        "pattern": [
          {
            "regexp": ".*"
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(Starting project|Starting Metro|Web is waiting)",
          "endsPattern": "(Web is waiting|Logs for your project will appear below)"
        }
      }
    }
  ]
}
